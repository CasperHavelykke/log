# Kopiér til .env.local og udfyld. .env.local er gitignored.

# --- Database ---
# Lokalt: brug en file: URL eller udelad helt (default = data/app.db).
# I produktion: brug libsql:// URL fra Turso + auth token.
# TURSO_DATABASE_URL=file:./data/app.db
# TURSO_DATABASE_URL=libsql://din-database-navn.turso.io
# TURSO_AUTH_TOKEN=

# --- Session ---
# Stor random hex-streng. Generer via: openssl rand -hex 32
SESSION_SECRET=

# --- MCP HTTP-endpoint ---
# Bearer-token som Claude bruger til at tilkalde /api/mcp.
# Generer via: openssl rand -hex 32. Hold hemmelig.
# Hvis ikke sat, returnerer /api/mcp 401 for alle requests.
MCP_HTTP_TOKEN=

# --- Vercel Blob (filer/billeder, kommer senere) ---
# BLOB_READ_WRITE_TOKEN=
