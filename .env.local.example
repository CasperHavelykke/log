# Kopiér til .env.local og udfyld. .env.local er gitignored.

# --- Database ---
# Lokalt: brug en file: URL eller udelad helt (default = data/app.db).
# I produktion: brug libsql:// URL fra Turso + auth token.
# TURSO_DATABASE_URL=file:./data/app.db
# TURSO_DATABASE_URL=libsql://din-database-navn.turso.io
# TURSO_AUTH_TOKEN=

# --- Session ---
# Stor random hex-streng. Generer via: openssl rand -hex 32
SESSION_SECRET=

# --- Auth.js (login via magic link, senere også Google) ---
# Hemmelighed til at signere session-tokens. Generer via: openssl rand -hex 32
AUTH_SECRET=

# Resend API key — opret på resend.com. Magic link sendes herfra.
AUTH_RESEND_KEY=

# Afsender på magic-link-mails. Indtil domæne er verificeret hos Resend,
# brug deres sandbox-afsender (kan kun sende til kontoens egen email).
EMAIL_FROM=onboarding@resend.dev

# Base-URL — typisk auto-detekteret, men sæt eksplicit hvis du oplever
# redirect-problemer (fx http://localhost:3000 lokalt, https://din-app.vercel.app i prod).
# AUTH_URL=http://localhost:3000

# --- MCP-endpoint auth ---
# /api/mcp bruger OAuth 2.0 (ikke statisk token mere).
# Opret OAuth-clients via /settings i appen — du får Client ID + Secret
# tilbage, som du indtaster i Claude's Custom Connector-dialog.
# Ingen env-var nødvendig for MCP-auth.

# --- Vercel Blob (filer/billeder, kommer senere) ---
# BLOB_READ_WRITE_TOKEN=
