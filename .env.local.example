# Kopiér til .env.local og udfyld. .env.local er gitignored.

# --- Database ---
# Lokal SQLite-fil. Udelad helt for at bruge default data/app.db.
# DATABASE_URL=file:./data/app.db
# DATABASE_PATH=./data/app.db

# --- Session ---
# Stor random hex-streng. Generer via: openssl rand -hex 32
SESSION_SECRET=

# --- Auth.js (login via magic link, senere også Google) ---
# Hemmelighed til at signere session-tokens. Generer via: openssl rand -hex 32
AUTH_SECRET=

# Resend API key — opret på resend.com. Magic link sendes herfra.
AUTH_RESEND_KEY=

# Afsender på magic-link-mails. Indtil domæne er verificeret hos Resend,
# brug deres sandbox-afsender (kan kun sende til kontoens egen email).
EMAIL_FROM=onboarding@resend.dev

# Base-URL — sæt eksplicit hvis du oplever redirect-problemer.
# AUTH_URL=https://din-server.dk

# --- MCP-endpoint auth ---
# /api/mcp bruger OAuth 2.0. Opret OAuth-clients via /indstillinger i appen
# — du får Client ID + Secret tilbage som indtastes i Claude's Custom Connector.
# Ingen env-var nødvendig for MCP-auth.

# --- Filer ---
# Fotos + dokumenter gemmes som filer under data/photos og data/documents.
# Ingen env-var nødvendig.
